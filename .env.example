# ─── Copia este archivo como .env.local para desarrollo. En Easypanel se configuran en "Environment". ───

# Base de datos Postgres.
# Local (npm run db:local):   postgres://postgres:postgres@127.0.0.1:5432/postgres
# Easypanel (URL interna del servicio Postgres): postgres://USUARIO:CLAVE@NOMBRE-SERVICIO:5432/BASE
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Solo en local con PGlite: 1. En Easypanel bórrala (por defecto 10).
DATABASE_POOL_MAX=1

# URL pública de la app (sin diagonal final).
APP_URL=http://localhost:3000

# Número de proxies de confianza delante de la app (Traefik de Easypanel = 1; con Cloudflare delante = 2).
TRUSTED_PROXY_HOPS=1

# Opcional: con este token, GET /api/health (Authorization: Bearer ...) también revisa la BD. Mín. 24 caracteres.
HEALTH_TOKEN=

# Días que se conserva la bitácora de auditoría.
AUDIT_RETENTION_DAYS=365

# ─── Almacenamiento MinIO / S3 (se usa a partir de la Fase 2) ───
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Web Push (se usa a partir de la Fase 6). Generar con: npx web-push generate-vapid-keys ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@ejemplo.com
