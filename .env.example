# ─── Copia este archivo como .env.local para desarrollo. En Easypanel se configuran en "Environment". ───

# Base de datos Postgres.
# Local (npm run db:local):   postgres://postgres:postgres@127.0.0.1:5432/postgres
# Easypanel (URL interna del servicio Postgres): postgres://USUARIO:CLAVE@NOMBRE-SERVICIO:5432/BASE
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Solo en local con PGlite: 1. En Easypanel bórrala (por defecto 10).
DATABASE_POOL_MAX=1

# URL pública de la app (sin diagonal final).
APP_URL=http://localhost:3000

# Número de proxies de confianza delante de la app (Traefik de Easypanel = 1; con Cloudflare delante = 2).
TRUSTED_PROXY_HOPS=1

# Opcional: con este token, GET /api/health (Authorization: Bearer ...) también revisa la BD. Mín. 24 caracteres.
HEALTH_TOKEN=

# Días que se conserva la bitácora de auditoría.
AUDIT_RETENTION_DAYS=365

# ─── Almacenamiento MinIO / S3 (Fase 1: video de bienvenida). Endpoint INTERNO de Easypanel, p. ej. http://NOMBRE-SERVICIO:9000 ───
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Pagos con Stripe (Fase 1). Modo prueba: sk_test_… / whsec_… / price_… ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PRO=
# Días de gracia tras un cobro fallido antes de suspender la sesión.
BILLING_GRACE_DAYS=7

# ─── Web Push (se usa a partir de la Fase 6). Generar con: npx web-push generate-vapid-keys ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@ejemplo.com

# ─── Skills de IA (Fase 2). Sin llave la app usa respuestas de prueba; con llave ejecuta las skills de Mishell con Claude ───
ANTHROPIC_API_KEY=
SKILLS_MODEL=claude-sonnet-5-5

# ─── Gemini (transcripción de audio, Fase 2; después calificador de foto y coach de video) ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Reservadas, todavía no se usan ───
# Fase 5: analizador de competencia y tendencias
APIFY_TOKEN=
# Fase 3: Instagram (API con inicio de sesión de Instagram)
META_APP_ID=
META_APP_SECRET=
